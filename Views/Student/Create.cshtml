@using MyWebApp.Models
@model Student

@{
    ViewData["Title"] = "Thêm mới sinh viên";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}

<div class="container-fluid px-4">
    <h2 class="mt-4">Thêm mới sinh viên</h2>
    <hr />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-route="student_add"
          method="post"
          enctype="multipart/form-data"
          class="mt-3">

        <!-- Họ tên -->
        <div style="margin-top:7px" class="form-group row">
            <label asp-for="Name" class="col-sm-2 col-form-label">Họ tên</label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ tên" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <!-- Email -->
        <div style="margin-top:7px" class="form-group row">
            <label asp-for="Email" class="col-sm-2 col-form-label">Email</label>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <!-- Password -->
        <div style="margin-top:7px" class="form-group row">
            <label asp-for="Password" class="col-sm-2 col-form-label">Password</label>
            <div class="col-sm-10">
                <input type="password"
                       asp-for="Password"
                       class="form-control"
                       placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>

        <!-- Ngành học -->
        <div style="margin-top:7px" class="form-group row">
            <label asp-for="Branch" class="col-sm-2 col-form-label">Ngành học</label>
            <div class="col-sm-10">
                <select asp-for="Branch"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<Branch>()">
                    <option value="">-- Chọn ngành học --</option>
                </select>
                <span asp-validation-for="Branch" class="text-danger"></span>
            </div>
        </div>

        <!-- Hệ đào tạo -->
        <div style="margin-top:7px" class="form-group row">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label">Hệ đào tạo</label>
            <div class="col-sm-10 d-flex align-items-center">
                <input type="checkbox"
                       class="form-check-input"
                       asp-for="IsRegular" />
                <label asp-for="IsRegular" class="ms-2">Chính quy</label>
                <span asp-validation-for="IsRegular" class="text-danger ms-3"></span>
            </div>
        </div>

        <!-- Ngày sinh -->
        <div style="margin-top:7px" class="form-group row">
            <label asp-for="DateOfBirth" class="col-sm-2 col-form-label">Ngày sinh</label>
            <div class="col-sm-10">
                <input asp-for="DateOfBirth"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>
        </div>
        <!-- Điểm  -->
        <div style="margin-top:7px" class="form-group row">
            <label asp-for="Score" class="col-sm-2 col-form-label">Điểm</label>
            <div class="col-sm-10">
                <input asp-for="Score"
                        type="number"
                        step="0.1"
                        class="form-control"
                        placeholder="Nhập điểm từ 0.0 đến 10.0" />
                <span asp-validation-for="Score" class="text-danger"></span>
           </div>
        </div>


        <!-- Giới tính -->
        <div style="margin-top:7px" class="form-group row">
            <label asp-for="Gender" class="col-sm-2 col-form-label">Giới tính</label>
            <div class="col-sm-10">
                @if (ViewBag.AllGenders != null)
                {
                    @foreach (Gender gender in ViewBag.AllGenders)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input"
                                   type="radio"
                                   asp-for="Gender"
                                   value="@gender"
                                   id="Gender@(gender)" />
                            <label class="form-check-label" for="Gender@(gender)">
                                @(gender == Gender.Male ? "Nam" : "Nữ")
                            </label>
                        </div>
                    }
                }
                <br />
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
        </div>

        <!-- Địa chỉ -->
        <div style="margin-top:7px" class="form-group row">
            <label asp-for="Address" class="col-sm-2 col-form-label">Địa chỉ</label>
            <div class="col-sm-10">
                <textarea asp-for="Address"
                          class="form-control"
                          placeholder="Địa chỉ"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <!-- Ảnh đại diện -->
        <div style="margin-top:7px" class="form-group row">
            <label asp-for="AvatarFile" class="col-sm-2 col-form-label">Ảnh đại diện</label>
            <div class="col-sm-10">
                <input asp-for="AvatarFile"
                       type="file"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.gif" />
                <span asp-validation-for="AvatarFile" class="text-danger"></span>
                <small class="text-muted">Chấp nhận JPG, JPEG, PNG, GIF; tối đa 2MB.</small>
            </div>
        </div>

        <!-- Nút thao tác -->
        <div style="margin-top:10px" class="form-group row">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-route="student_list" class="btn btn-secondary">Quay lại danh sách</a>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}